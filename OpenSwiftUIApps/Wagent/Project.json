{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Wagent",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Wagent": {
      "deploymentTarget": "26.0",
      "entitlements": {
        "path": "App/App.entitlements",
        "properties": {
          "com.apple.security.app-sandbox": true,
          "com.apple.security.device.audio-input": true,
          "com.apple.security.network.client": true,
          "com.apple.security.files.user-selected.read-write": true
        }
      },
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Wagent",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "LSApplicationCategoryType": "public.app-category.productivity",
          "NSMicrophoneUsageDescription": "Wagent uses the microphone to transcribe your voice into the document so you can write hands-free.",
          "NSSpeechRecognitionUsageDescription": "Wagent transcribes your speech locally to let you dictate text directly into your document."
        }
      },
      "platform": "macOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_DEBUG_DYLIB": "NO",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.44f2fcc7-8095-40c3-ad63-98d7e102dae3",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "type": "application"
    }
  }
}
